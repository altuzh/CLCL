        MENUITEM "&Сохранить как...\tCtrl+S",         ID_MENUITEM_DATA_SAVE
        MENUITEM "&Горячая клавиша...",             ID_MENUITEM_SET_HOTKEY
        POPUP "&Настройки"
        BEGIN
            MENUITEM "&Формат...",                  ID_MENUITEM_SET_FORMAT
            MENUITEM "Ф&ильтр...",                  ID_MENUITEM_SET_FILTER
        END
        MENUITEM SEPARATOR
        MENUITEM "Создать &копию...\tCtrl+R",     ID_MENUITEM_REGIST_ADD
        MENUITEM "П&ереместить в...\tSCtrl+R",        ID_MENUITEM_REGIST_MOVE
        MENUITEM SEPARATOR
        MENUITEM "Пере&именовать",                     ID_MENUITEM_RENAME
        MENUITEM "Очистить и&мя",                 ID_MENUITEM_CLEAR_NAME
        MENUITEM SEPARATOR
        MENUITEM "&Удалить",                     ID_MENUITEM_DELETE
    END
    POPUP "Избранное(LV)"
    BEGIN
        MENUITEM "&Открыть",                       ID_MENUITEM_OPEN
        MENUITEM SEPARATOR
        MENUITEM "&В буфер обмена\tCtrl+C",  ID_MENUITEM_CLIPBOARD
        MENUITEM "&Вставить из буфера\tCtrl+V", ID_MENUITEM_PASTE
        MENUITEM "&Инструменты",                      ID_MENUITEM_TOOL_MENU
        MENUITEM SEPARATOR
        MENUITEM "&Вверх\tAlt+Up",            ID_MENUITEM_UP
        MENUITEM "В&низ\tAlt+Down",        ID_MENUITEM_DOWN
        MENUITEM SEPARATOR
        MENUITEM "&Новый элемент...\tCtrl+N",        ID_MENUITEM_NEW_ITEM
        MENUITEM "Новая &папка",                 ID_MENUITEM_CREATE_FOLDER
        MENUITEM "&Сохранить как...\tCtrl+S",         ID_MENUITEM_DATA_SAVE
        MENUITEM "&Горячая клавиша...",             ID_MENUITEM_SET_HOTKEY
        MENUITEM SEPARATOR
        MENUITEM "Создать &копию...\tCtrl+R",     ID_MENUITEM_REGIST_ADD
        MENUITEM "П&ереместить в...\tSCtrl+R",        ID_MENUITEM_REGIST_MOVE
        MENUITEM SEPARATOR
        MENUITEM "Пере&именовать",                     ID_MENUITEM_RENAME
        MENUITEM "Очистить и&мя",                 ID_MENUITEM_CLEAR_NAME
        MENUITEM SEPARATOR
        MENUITEM "&Удалить",                     ID_MENUITEM_DELETE
    END
    POPUP "Перетаскивание"
    BEGIN
        MENUITEM "&Копировать сюда",                  ID_MENU_DGDP_COPY
        MENUITEM "&Переместить сюда",                  ID_MENU_DGDP_MOVE
        MENUITEM SEPARATOR
        MENUITEM "От&мена",                     IDCANCEL
    END
END

IDR_MENU_VIEWER MENU
BEGIN
    POPUP "&Файл"
    BEGIN
        MENUITEM "&Новый элемент...\tCtrl+N",        ID_MENUITEM_NEW_ITEM
        MENUITEM "&Сохранить как...\tCtrl+S",         ID_MENUITEM_DATA_SAVE
        MENUITEM SEPARATOR
        MENUITEM "Сохранить со&стояние\tSCtrl+S", ID_MENUITEM_SAVE
        MENUITEM SEPARATOR
        MENUITEM "&Импорт...",                  ID_MENUITEM_IMPORT
        MENUITEM "&Экспорт...",                  ID_MENUITEM_EXPORT
        MENUITEM SEPARATOR
        MENUITEM "&Следить за буфером",            ID_MENUITEM_WATCH
        MENUITEM SEPARATOR
        MENUITEM "&Закрыть окно",               ID_MENUITEM_CLOSE
        MENUITEM "В&ыход",                       ID_MENUITEM_EXIT
    END
    POPUP "&Правка"
    BEGIN
        MENUITEM "&В буфер обмена\tCtrl+C",  ID_MENUITEM_CLIPBOARD
        MENUITEM "&Вставить из буфера\tCtrl+V", ID_MENUITEM_PASTE
        MENUITEM "Добавить в &избранное...\tCtrl+R", ID_MENUITEM_REGIST_ADD
        MENUITEM SEPARATOR
        MENUITEM "&Вверх\tAlt+Up",            ID_MENUITEM_UP
        MENUITEM "В&низ\tAlt+Down",        ID_MENUITEM_DOWN
        MENUITEM SEPARATOR
        MENUITEM "&Удалить",                     ID_MENUITEM_DELETE
        MENUITEM SEPARATOR
        MENUITEM "Выделить &всё\tCtrl+A",         ID_MENUITEM_SELECT_ALL
    END
    POPUP "&Вид"
    BEGIN
        MENUITEM "&Панель инструментов",                    ID_MENUITEM_SHOW_TOOLBAR
        MENUITEM "&Строка состояния",                 ID_MENUITEM_SHOW_STATUSBAR
        MENUITEM SEPARATOR
        MENUITEM "Показывать &форматы",        ID_MENUITEM_SHOW_FORMAT
        MENUITEM "&Двоичный вид",                ID_MENUITEM_SHOW_BIN
        MENUITEM SEPARATOR
        MENUITEM "&Настройки...",                 ID_MENUITEM_OPTION
    END
    POPUP "&Инструменты"
    BEGIN
        MENUITEM "Настройка &инструментов...",              ID_MENUITEM_TOOL_SET
        MENUITEM SEPARATOR
    END
    POPUP "&Справка"
    BEGIN
        MENUITEM "&О программе...",                   ID_MENUITEM_ABOUT
    END
END


